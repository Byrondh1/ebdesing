# Copia este archivo a .env y rellénalo.
# El project ID no es secreto (viaja en el frontend de cualquier sitio con Sanity),
# pero se lee del entorno para no tenerlo escrito en el código.

SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-09-17

# Paso 8 del BUILD ORDER — formulario de cotización. Este SÍ es secreto.
RESEND_API_KEY=
CONTACT_EMAIL=

# Opcional, solo desarrollo sin red: construye con contenido de ejemplo en vez de
# Sanity. NUNCA la pongas en Cloudflare Pages — el build se niega si la detecta ahí.
# USAR_CONTENIDO_LOCAL=1
