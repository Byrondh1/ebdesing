---
import Button from '../ui/Button.astro';
import type { Servicio } from '../../lib/tipos';

interface Props {
  servicios: Servicio[];
  /** Se ofrece como alternativa si el envío falla. */
  enlaceWhatsapp: string;
  /** Promesa de plazo, editable en Sanity. */
  tiempoRespuesta?: string;
}

const { servicios, enlaceWhatsapp, tiempoRespuesta } = Astro.props;

const campo =
  'mt-2 w-full rounded-md border border-brand-gray/40 bg-brand-white px-4 py-2.5 text-brand-black ' +
  'focus-visible:border-brand-gold focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-brand-gold ' +
  'aria-[invalid=true]:border-red-600';
const etiqueta = 'block font-semibold';
const error = 'mt-1 text-sm text-red-700';
---

<form id="form-cotizacion" novalidate class="space-y-5" data-whatsapp={enlaceWhatsapp}>
  <div>
    <label for="nombre" class={etiqueta}>Nombre <span aria-hidden="true">*</span></label>
    <input
      type="text"
      id="nombre"
      name="nombre"
      required
      minlength="2"
      maxlength="100"
      autocomplete="name"
      aria-describedby="error-nombre"
      class={campo}
    />
    <p id="error-nombre" class={error} data-error-de="nombre" hidden></p>
  </div>

  <div>
    <label for="email" class={etiqueta}>Correo <span aria-hidden="true">*</span></label>
    <input
      type="email"
      id="email"
      name="email"
      required
      maxlength="200"
      autocomplete="email"
      aria-describedby="error-email"
      class={campo}
    />
    <p id="error-email" class={error} data-error-de="email" hidden></p>
  </div>

  <div>
    <label for="telefono" class={etiqueta}>Teléfono</label>
    <input
      type="tel"
      id="telefono"
      name="telefono"
      maxlength="30"
      autocomplete="tel"
      aria-describedby="error-telefono"
      class={campo}
    />
    <p id="error-telefono" class={error} data-error-de="telefono" hidden></p>
  </div>

  <div>
    <label for="servicioInteres" class={etiqueta}>¿Qué necesitas?</label>
    <select id="servicioInteres" name="servicioInteres" class={campo}>
      <option value="">Todavía no lo tengo claro</option>
      {servicios.map((servicio) => <option value={servicio.titulo}>{servicio.titulo}</option>)}
    </select>
  </div>

  <div>
    <label for="mensaje" class={etiqueta}>Cuéntanos</label>
    <textarea
      id="mensaje"
      name="mensaje"
      rows="5"
      maxlength="2000"
      aria-describedby="error-mensaje"
      class={campo}></textarea>
    <p id="error-mensaje" class={error} data-error-de="mensaje" hidden></p>
  </div>

  <div>
    <label for="privacidad" class="flex items-start gap-3">
      {/* Sin `checked`: el consentimiento tiene que ser un acto del visitante.
          Una casilla premarcada no vale como consentimiento. */}
      <input
        type="checkbox"
        id="privacidad"
        name="privacidad"
        required
        aria-describedby="error-privacidad"
        class="mt-1 size-5 shrink-0 accent-brand-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold"
      />
      <span class="text-sm text-brand-gray">
        He leído y acepto la{' '}
        <a
          href="/privacidad/"
          class="rounded font-semibold text-brand-black underline decoration-brand-gold underline-offset-4 hover:text-brand-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold"
        >
          política de privacidad
        </a>
        . <span aria-hidden="true">*</span>
      </span>
    </label>
    <p id="error-privacidad" class={error} data-error-de="privacidad" hidden></p>
  </div>

  {/* Trampa para bots. Oculto visualmente y para lectores de pantalla, y fuera del
      orden de tabulación: una persona no puede rellenarlo sin querer.

      No se usa `display:none` a propósito — muchos bots saltan esos campos, que es
      justo lo contrario de lo que se busca. Se esconde con tamaño y opacidad, y el
      propio input los lleva para no depender del recorte del contenedor. */}
  <div class="pointer-events-none absolute h-px w-px overflow-hidden opacity-0" aria-hidden="true">
    <label for="honeypot">No rellenes este campo</label>
    <input
      type="text"
      id="honeypot"
      name="honeypot"
      tabindex="-1"
      autocomplete="off"
      class="h-px w-px border-0 p-0 opacity-0"
    />
  </div>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
    <Button type="submit" tamano="lg" class="w-full sm:w-auto">
      <span data-texto-boton>Enviar cotización</span>
    </Button>
    {tiempoRespuesta && <p class="text-sm text-brand-gray">{tiempoRespuesta}</p>}
  </div>

  {/* aria-live para que un lector de pantalla anuncie el resultado sin mover el foco. */}
  <p id="estado-cotizacion" role="status" aria-live="polite" class="text-sm" hidden></p>
</form>

<script>
  const form = document.getElementById('form-cotizacion') as HTMLFormElement | null;
  if (form) {
    const estado = document.getElementById('estado-cotizacion')!;
    const boton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const textoBoton = form.querySelector('[data-texto-boton]')!;
    const enlaceWhatsapp = form.dataset.whatsapp!;

    const errores = new Map<string, HTMLElement>();
    for (const p of form.querySelectorAll<HTMLElement>('[data-error-de]')) {
      errores.set(p.dataset.errorDe!, p);
    }

    const limpiarErrores = () => {
      for (const [campo, p] of errores) {
        p.hidden = true;
        p.textContent = '';
        form.elements.namedItem(campo)?.removeAttribute('aria-invalid');
      }
    };

    const mostrarError = (campo: string, mensaje: string) => {
      const p = errores.get(campo);
      if (!p) return;
      p.textContent = mensaje;
      p.hidden = false;
      form.elements.namedItem(campo)?.setAttribute('aria-invalid', 'true');
    };

    const mensajeNativo = (control: HTMLInputElement) => {
      if (control.validity.valueMissing)
        return control.type === 'checkbox'
          ? 'Hay que aceptar la política de privacidad para poder responderte.'
          : 'Este campo es obligatorio.';
      if (control.validity.typeMismatch) return 'El correo no tiene un formato válido.';
      if (control.validity.tooShort) return 'Todavía es muy corto.';
      return 'Revisa este campo.';
    };

    /**
     * Valida en el navegador ANTES de tocar la red: con un campo obligatorio vacío
     * no se hace ninguna petición. El servidor vuelve a validar igual.
     */
    const validarEnCliente = () => {
      limpiarErrores();
      let primerFallo: HTMLInputElement | null = null;

      for (const control of form.querySelectorAll<HTMLInputElement>('input[required], input[type="email"]')) {
        if (control.name === 'honeypot') continue;
        // Un checkbox no tiene `value` útil: se juzga por checkValidity(), que ya
        // devuelve false si es obligatorio y está sin marcar.
        if (control.type !== 'checkbox' && !control.value && !control.required) continue;
        if (!control.checkValidity()) {
          mostrarError(control.name, mensajeNativo(control));
          primerFallo ??= control;
        }
      }

      primerFallo?.focus();
      return primerFallo === null;
    };

    form.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      estado.hidden = true;

      if (!validarEnCliente()) return;

      boton.disabled = true;
      textoBoton.textContent = 'Enviando…';

      const datos = Object.fromEntries(new FormData(form).entries());

      try {
        const respuesta = await fetch('/api/cotizacion', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(datos),
        });
        const cuerpo = await respuesta.json().catch(() => ({}));

        if (respuesta.ok && cuerpo.ok) {
          // Solo se navega cuando el servidor CONFIRMA el envío. Si Resend falla,
          // el visitante se queda aquí con el error: mandarlo a /gracias le haría
          // creer que su mensaje salió cuando no salió.
          form.reset();
          estado.className = 'rounded-md bg-brand-gold px-4 py-3 text-sm font-semibold text-brand-black';
          estado.textContent = 'Recibido. Te llevamos a la confirmación…';
          estado.hidden = false;
          window.location.assign('/gracias/');
          return;
        }

        if (respuesta.status === 400 && cuerpo.campos) {
          for (const [campo, mensaje] of Object.entries(cuerpo.campos)) {
            mostrarError(campo, String(mensaje));
          }
          estado.className = 'text-sm text-red-700';
          estado.textContent = 'Revisa los campos marcados.';
          estado.hidden = false;
          return;
        }

        throw new Error(cuerpo.error ?? 'fallo del servidor');
      } catch {
        // No perdemos el contacto: si el correo falla, se ofrece WhatsApp.
        estado.className = 'rounded-md border border-red-600 px-4 py-3 text-sm';
        estado.innerHTML =
          'No pudimos enviar tu mensaje. Escríbenos por ' +
          `<a href="${enlaceWhatsapp}" class="font-semibold underline">WhatsApp</a> y lo resolvemos ahí.`;
        estado.hidden = false;
      } finally {
        boton.disabled = false;
        textoBoton.textContent = 'Enviar cotización';
      }
    });
  }
</script>
