---
import type { Testimonio } from '../../lib/tipos';

interface Props {
  testimonios: Testimonio[];
}

const { testimonios } = Astro.props;
---

<section class="bg-brand-white py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="font-display text-3xl font-bold sm:text-4xl">Lo que dicen los clientes</h2>

    <ul class="mt-12 grid gap-6 md:grid-cols-2">
      {
        testimonios.map((testimonio) => (
          <li>
            <figure class="flex h-full flex-col rounded-lg border-l-4 border-brand-gold bg-brand-black/[0.03] p-6">
              <blockquote class="flex-1 text-lg text-balance">
                <p>«{testimonio.cita}»</p>
              </blockquote>
              <figcaption class="mt-4 text-sm">
                <span class="font-semibold">{testimonio.nombreCliente}</span>
                <span class="text-brand-gray"> · {testimonio.empresa}</span>
                {
                  testimonio.perfilGoogle && (
                    <>
                      {' · '}
                      <a
                        href={testimonio.perfilGoogle}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="rounded underline decoration-brand-gold underline-offset-4 hover:text-brand-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold"
                      >
                        ver reseña
                      </a>
                    </>
                  )
                }
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
