---
import Card from '../ui/Card.astro';
import type { Proyecto, Servicio } from '../../lib/tipos';

interface Props {
  servicios: Servicio[];
  /** En la Home se muestra un resumen; en /servicios, todo. */
  mostrarCompleto?: boolean;
  /** Proyectos por slug de servicio. Solo se pasa en /servicios. */
  proyectosPorServicio?: Record<string, Proyecto[]>;
}

const { servicios, mostrarCompleto = false, proyectosPorServicio } = Astro.props;
---

<section class="bg-brand-white py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="font-display text-3xl font-bold sm:text-4xl">Qué hacemos</h2>
    <p class="mt-3 max-w-xl text-brand-gray">
      Cuatro frentes que cubren el ciclo completo de una marca.
    </p>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        servicios.map((servicio) => {
          const relacionados = proyectosPorServicio?.[servicio.slug] ?? [];
          return (
            <li>
              {/* El id permite enlazar a un servicio concreto desde la ficha de
                  un proyecto: /servicios/#identidad-de-marca */}
              <Card class="h-full scroll-mt-24" id={servicio.slug}>
                <h3 class="font-display text-xl font-bold">{servicio.titulo}</h3>
                <p class="mt-3 flex-1 text-brand-gray">
                  {mostrarCompleto ? servicio.descripcionCompleta : servicio.descripcionCorta}
                </p>

                {/* Sin proyectos enlazados no se pinta nada: una sección vacía
                    resta más de lo que suma. */}
                {relacionados.length > 0 && (
                  <div class="mt-5 border-t border-brand-gray/25 pt-4">
                    <h4 class="font-display text-xs tracking-widest text-brand-gray uppercase">
                      Proyectos donde lo aplicamos
                    </h4>
                    <ul class="mt-2 space-y-1">
                      {relacionados.map((proyecto) => (
                        <li>
                          <a
                            href={`/portafolio/${proyecto.slug}/`}
                            class="rounded text-sm font-medium underline decoration-brand-gold underline-offset-4 hover:text-brand-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold"
                          >
                            {proyecto.titulo}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {mostrarCompleto && (
                  <a
                    href="/contacto/"
                    class="mt-5 rounded font-semibold underline decoration-brand-gold underline-offset-4 hover:text-brand-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold"
                  >
                    Cotizar este servicio →
                  </a>
                )}
              </Card>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
