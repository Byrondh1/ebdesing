---
interface Props {
  /** Si viene, toda la tarjeta es un enlace. */
  href?: string;
  /** Ancla, para poder enlazar a una tarjeta concreta desde otra página. */
  id?: string;
  class?: string;
}

const { href, id, class: claseExtra } = Astro.props;
const Etiqueta = href ? 'a' : 'div';
---

<Etiqueta
  href={href}
  id={id}
  class:list={[
    'group flex flex-col rounded-lg border border-brand-gray/25 bg-brand-white p-6 text-brand-black transition-colors',
    href &&
      'hover:border-brand-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold',
    claseExtra,
  ]}
>
  <slot />
</Etiqueta>
