---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import CTA from '../../components/sections/CTA.astro';
import { obtenerProyectos, obtenerConfiguracion, enlaceWhatsapp } from '../../lib/contenido';
import { recortar, conjuntoDeFuentes } from '../../lib/imagenes';
import Migas from '../../components/Migas.astro';
import { migas, obraCreativa } from '../../lib/seo';
import type { Proyecto } from '../../lib/tipos';

/**
 * Una página por proyecto. El proyecto entero viaja en `props` para no volver a
 * consultar Sanity una vez por ruta: `obtenerProyectos()` ya trajo todo.
 */
export async function getStaticPaths() {
  const proyectos = await obtenerProyectos();
  return proyectos.map((proyecto) => ({
    params: { slug: proyecto.slug },
    props: { proyecto },
  }));
}

interface Props {
  proyecto: Proyecto;
}

const { proyecto } = Astro.props;
const { telefonoWhatsapp } = await obtenerConfiguracion();

const portada = recortar(proyecto.imagenPrincipal, 1600, 900);
const portadaFuentes = conjuntoDeFuentes(proyecto.imagenPrincipal, [640, 1024, 1600, 2000], 16 / 9);
const galeria = (proyecto.galeria ?? [])
  .map((imagen) => ({
    ...imagen,
    src: recortar(imagen, 1200),
    fuentes: conjuntoDeFuentes(imagen, [600, 900, 1200]),
  }))
  .filter((imagen) => Boolean(imagen.src));

// La meta description sale del contenido del editor, así que hay que recortarla:
// pasada de largo, Google la trunca igual y la auditoría avisa.
const descripcion = `${proyecto.titulo} — ${proyecto.categoria} para ${proyecto.cliente}. ${proyecto.descripcion}`
  .replace(/\s+/g, ' ')
  .slice(0, 160)
  .trim();

const mensajeWhatsapp = `Hola, vi el proyecto "${proyecto.titulo}" en su portafolio y quiero algo parecido.`;
---

<Base
  titulo={proyecto.titulo}
  descripcion={descripcion}
  ogImagen={proyecto.imagenPrincipal?.url ?? '/og/portafolio.png'}
  jsonLd={[
    obraCreativa(proyecto, Astro.site),
    migas(
      [
        { nombre: 'Portafolio', href: '/portafolio' },
        { nombre: proyecto.titulo, href: `/portafolio/${proyecto.slug}/` },
      ],
      Astro.site
    ),
  ]}
>
  <article>
    <section class="bg-brand-black py-16 text-brand-white sm:py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <Migas
          ruta={[
            { nombre: 'Portafolio', href: '/portafolio/' },
            { nombre: proyecto.titulo, href: `/portafolio/${proyecto.slug}/` },
          ]}
        />

        <Badge variante="oro" class="mt-6">{proyecto.categoria}</Badge>
        <h1 class="mt-4 max-w-3xl font-display text-4xl font-bold sm:text-5xl">{proyecto.titulo}</h1>
        <p class="mt-4 text-lg text-brand-white/70">Cliente: {proyecto.cliente}</p>
      </div>
    </section>

    {
      portada && (
        <img
          src={portada}
          srcset={portadaFuentes}
          sizes="100vw"
          alt={proyecto.imagenPrincipal?.alt || proyecto.titulo}
          width="1600"
          height="900"
          fetchpriority="high"
          decoding="async"
          class="aspect-video w-full object-cover"
        />
      )
    }

    <section class="py-16 sm:py-20">
      <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 md:grid-cols-3">
        <div class="md:col-span-2">
          <h2 class="font-display text-2xl font-bold">El proyecto</h2>
          <p class="mt-4 text-lg text-brand-gray">{proyecto.descripcion}</p>

          {/* Los dos tiempos del caso. Son opcionales en Sanity, así que cada uno
              aparece solo si está: media sección vacía se nota más que su ausencia. */}
          {
            proyecto.reto && (
              <div class="mt-10">
                <h3 class="font-display text-xs tracking-widest text-brand-gray uppercase">El reto</h3>
                <p class="mt-2 text-lg">{proyecto.reto}</p>
              </div>
            )
          }
          {
            proyecto.solucion && (
              <div class="mt-8">
                <h3 class="font-display text-xs tracking-widest text-brand-gray uppercase">La solución</h3>
                <p class="mt-2 text-lg">{proyecto.solucion}</p>
              </div>
            )
          }
        </div>

        <aside class="border-l-4 border-brand-gold pl-6">
          <h2 class="font-display text-sm tracking-widest text-brand-gray uppercase">Resultado</h2>
          <p class="mt-3 text-lg">{proyecto.resultado}</p>
          <Button href={enlaceWhatsapp(telefonoWhatsapp, mensajeWhatsapp)} class="mt-6">
            Quiero algo así
          </Button>

          {/* Enlace de vuelta a los servicios. Si el proyecto no tiene ninguno
              enlazado en Sanity, no se pinta la sección. */}
          {
            proyecto.servicios && proyecto.servicios.length > 0 && (
              <div class="mt-8 border-t border-brand-gray/25 pt-6">
                <h3 class="font-display text-xs tracking-widest text-brand-gray uppercase">
                  Servicios que intervinieron
                </h3>
                <ul class="mt-2 space-y-1">
                  {proyecto.servicios.map((servicio) => (
                    <li>
                      <a
                        href={`/servicios/#${servicio.slug}`}
                        class="rounded font-medium underline decoration-brand-gold underline-offset-4 hover:text-brand-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold"
                      >
                        {servicio.titulo}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </aside>
      </div>
    </section>

    {
      galeria.length > 0 && (
        <section class="pb-16 sm:pb-20">
          <div class="mx-auto max-w-6xl px-4 sm:px-6">
            <h2 class="font-display text-2xl font-bold">Galería</h2>
            <ul class="mt-8 grid gap-6 sm:grid-cols-2">
              {galeria.map((imagen) => (
                <li>
                  <img
                    src={imagen.src}
                    srcset={imagen.fuentes}
                    sizes="(min-width: 640px) 45vw, 100vw"
                    alt={imagen.alt || proyecto.titulo}
                    width={imagen.ancho ?? 1200}
                    height={imagen.alto ?? 900}
                    loading="lazy"
                    decoding="async"
                    class="w-full rounded-lg object-cover"
                  />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }
  </article>

  <CTA
    titulo="¿Quieres algo parecido?"
    texto="Cuéntanos tu proyecto y te mandamos una cotización."
  />
</Base>
