---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Servicios from '../components/sections/Servicios.astro';
import Proyectos from '../components/sections/Proyectos.astro';
import Testimonios from '../components/sections/Testimonios.astro';
import CTA from '../components/sections/CTA.astro';
import {
  serviciosOrdenados,
  proyectosDestacados,
  testimonios,
} from '../lib/contenido-temporal';
---

<Base
  titulo="Agencia de Diseño y Publicidad"
  descripcion="EBDesing diseña identidad de marca, campañas publicitarias y gran formato en Ecuador. Pide tu cotización por WhatsApp o formulario."
>
  <Hero />
  <Servicios servicios={serviciosOrdenados} />
  <Proyectos proyectos={proyectosDestacados} />
  <Testimonios testimonios={testimonios} />
  <CTA />
</Base>
