---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Servicios from '../components/sections/Servicios.astro';
import Proyectos from '../components/sections/Proyectos.astro';
import Testimonios from '../components/sections/Testimonios.astro';
import CTA from '../components/sections/CTA.astro';
import {
  obtenerServicios,
  obtenerProyectosDestacados,
  obtenerTestimonios,
} from '../lib/contenido';
import { listaDeServicios } from '../lib/seo';

const [servicios, proyectosDestacados, testimonios] = await Promise.all([
  obtenerServicios(),
  obtenerProyectosDestacados(),
  obtenerTestimonios(),
]);
---

<Base
  titulo="Agencia de Diseño y Publicidad"
  descripcion="EBDesing diseña identidad de marca, campañas publicitarias y gran formato en Ecuador. Pide tu cotización por WhatsApp o formulario."
  ogImagen="/og/inicio.png"
  jsonLd={[listaDeServicios(servicios, Astro.site)]}
>
  <Hero />
  <Servicios servicios={servicios} />
  <Proyectos proyectos={proyectosDestacados} />
  <Testimonios testimonios={testimonios} />
  <CTA />
</Base>
