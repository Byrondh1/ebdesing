---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import FormularioCotizacion from '../components/sections/FormularioCotizacion.astro';
import { obtenerConfiguracion, obtenerServicios, enlaceWhatsapp } from '../lib/contenido';
import Migas from '../components/Migas.astro';
import MapaLocal from '../components/MapaLocal.astro';
import { migas } from '../lib/seo';

const [{ emailContacto, direccion, telefonoWhatsapp, tiempoRespuesta, local }, servicios] = await Promise.all([
  obtenerConfiguracion(),
  obtenerServicios(),
]);

const whatsapp = enlaceWhatsapp(telefonoWhatsapp);

// Con calle y ciudad hay local de verdad; si no, se muestra solo la cobertura.
const hayLocal = Boolean(local?.calle && local?.ciudad);
const direccionMostrada = hayLocal
  ? [local!.calle, local!.ciudad, local!.provincia].filter(Boolean).join(', ')
  : direccion;
---

<Base
  titulo="Contacto"
  descripcion="Pide tu cotización a EBDesing por formulario o WhatsApp. Diseño y publicidad en Ecuador."
  ogImagen="/og/contacto.png"
  jsonLd={[migas([{ nombre: 'Contacto', href: '/contacto' }], Astro.site)]}
>
  <section class="bg-brand-black py-16 text-brand-white sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <Migas ruta={[{ nombre: 'Contacto', href: '/contacto/' }]} />
      <h1 class="mt-6 font-display text-4xl font-bold sm:text-5xl">Cotiza tu proyecto</h1>
      <p class="mt-4 max-w-2xl text-lg text-brand-white/80">
        Cuéntanos qué necesitas y te respondemos con una propuesta y un precio. Puedes usar el
        formulario o escribir directo por WhatsApp; en ambos casos contestamos en menos de 24
        horas hábiles.
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 md:grid-cols-5">
      <div class="md:col-span-3">
        <h2 class="font-display text-2xl font-bold">Pide tu cotización</h2>
        <p class="mt-2 text-brand-gray">
          Los campos con <span aria-hidden="true">*</span> son obligatorios.
        </p>
        <div class="mt-8">
          <FormularioCotizacion
            servicios={servicios}
            enlaceWhatsapp={whatsapp}
            tiempoRespuesta={tiempoRespuesta}
          />
        </div>
      </div>

      <div class="md:col-span-2">
        <h2 class="font-display text-2xl font-bold">O escríbenos directo</h2>
        <p class="mt-3 text-brand-gray">
          Si prefieres hablar antes de llenar nada, estos son los canales rápidos.
        </p>

        <div class="mt-6 flex flex-col gap-3">
          <Button href={whatsapp}>WhatsApp</Button>
          <Button href={`mailto:${emailContacto}`} variante="contorno">Correo</Button>
        </div>
        {tiempoRespuesta && <p class="mt-3 text-sm text-brand-gray">{tiempoRespuesta}</p>}

        <dl class="mt-10 space-y-4 text-sm">
          <div>
            <dt class="font-display tracking-widest text-brand-gray uppercase">Correo</dt>
            <dd class="mt-1">
              <a
                href={`mailto:${emailContacto}`}
                class="rounded hover:text-brand-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold"
              >
                {emailContacto}
              </a>
            </dd>
          </div>
          <div>
            <dt class="font-display tracking-widest text-brand-gray uppercase">
              {hayLocal ? 'Dónde estamos' : 'Cobertura'}
            </dt>
            <dd class="mt-1">{direccionMostrada}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  {
    hayLocal && local?.mapaIncrustado && (
      <section class="pb-16 sm:pb-20">
        <div class="mx-auto max-w-6xl px-4 sm:px-6">
          <h2 class="font-display text-2xl font-bold">Cómo llegar</h2>
          <p class="mt-2 text-brand-gray">
            El mapa se carga solo si lo pides: hasta entonces esta página no habla con Google.
          </p>
          <div class="mt-6">
            <MapaLocal local={local} />
          </div>
        </div>
      </section>
    )
  }
</Base>
