---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import { organizacion, sitioWeb } from '../lib/seo';
import { obtenerConfiguracion } from '../lib/contenido';

interface Props {
  /** Parte específica de la página; Base le añade el nombre de la marca. */
  titulo: string;
  descripcion: string;
  /** Imagen OG propia de la página. Ver `scripts/generar-og.mjs`. */
  ogImagen?: string;
  noindex?: boolean;
  /** Schemas JSON-LD propios de la página. Organization y WebSite ya van en todas. */
  jsonLd?: Record<string, unknown>[];
}

const { titulo, descripcion, ogImagen, noindex = false, jsonLd = [] } = Astro.props;

const tituloCompleto = `${titulo} · EBDesing`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImagenAbsoluta = ogImagen ? new URL(ogImagen, Astro.site).href : undefined;

// Organization y WebSite identifican al dominio entero, así que van en cada página.
// Las páginas no indexadas no aportan nada aquí y se quedan sin datos estructurados.
const schemas = noindex
  ? []
  : [organizacion(Astro.site, await obtenerConfiguracion()), sitioWeb(Astro.site), ...jsonLd];
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Preload de las dos fuentes: ambas se usan por encima del pliegue (titular en
        display, párrafos en body), así que esperar a que el CSS las descubra costaría
        un salto de tipografía visible. `crossorigin` es obligatorio en fuentes aunque
        sean del mismo origen; sin él el navegador descarga el archivo dos veces. */}
    <link
      rel="preload"
      href="/fonts/archivo-black-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin />

    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EBDesing" />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    {
      ogImagenAbsoluta && (
        <>
          <meta property="og:image" content={ogImagenAbsoluta} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={tituloCompleto} />
        </>
      )
    }

    <meta name="twitter:card" content={ogImagenAbsoluta ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descripcion} />
    {ogImagenAbsoluta && <meta name="twitter:image" content={ogImagenAbsoluta} />}

    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>

  <body class="flex min-h-screen flex-col bg-brand-white text-brand-black">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-brand-gold focus:px-4 focus:py-2 focus:font-semibold focus:text-brand-black"
    >
      Saltar al contenido
    </a>

    <Header />

    <main id="contenido" class="flex-1">
      <slot />
    </main>

    <Footer />

    <BotonWhatsApp />
  </body>
</html>
