# Copia este archivo a .dev.vars — NO se commitea.
#
# Ojo: estas son variables de RUNTIME del worker de Cloudflare, y NO se leen de .env
# ni del shell. Van aquí porque es la convención de wrangler, y el endpoint las lee
# con `import { env } from "cloudflare:workers"`.
#
# En producción se configuran en el panel de Cloudflare Pages, no en un archivo.

RESEND_API_KEY=
CONTACT_EMAIL=

# Remitente. Si se deja vacío usa onboarding@resend.dev, que SOLO entrega al correo
# de la cuenta de Resend — sirve para probar, no para producción. Para usar el
# dominio propio hay que verificarlo antes en Resend (Domains → Add Domain).
# REMITENTE_COTIZACION=EBDesing <cotizaciones@ebdesing.ebcorp.dev>

# Opcional, solo desarrollo: registra la cotización en consola en vez de enviarla,
# para probar el formulario sin cuenta de Resend. El endpoint se niega a usarlo si
# detecta CF_PAGES.
# COTIZACION_SIMULADA=1
