# Cabeceras para Cloudflare Pages.
# Ojo: el adaptador de Astro genera su propio bloque para /_astro/*; comprueba tras
# el build que ambos siguen en dist/client/_headers.

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800
